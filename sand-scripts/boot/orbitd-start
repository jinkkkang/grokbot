#!/usr/bin/env bash
# =============================================================================
# orbitd-start — 镜像 daemon 的 launcher（学习摘录，专有代码）
#
# 沙箱路径是 /usr/local/libexec/sand/orbitd/start。不由 supervise-* 调用，
# 而由 sand-exit-watch 按 --daemon-launcher orbitd=<本文件> 拉起。
# 清空环境后交给 sand-daemon-supervisor run orbitd，stdout 经 box-bounded-log
# 收到 /tmp/sand-orbitd.log。本脚本退出后，exit-watch 按自己的退避再拉一次。
# =============================================================================
set -euo pipefail

LOG_PATH="/tmp/sand-orbitd.log"

args=(run)

if [[ -n "${SAND_ORBITD_CHANNEL+x}" ]]; then
	args+=(--channel "$SAND_ORBITD_CHANNEL")
fi

if [[ -n "${SAND_ORBITD_UPDATE_CHECK_INTERVAL_SECONDS+x}" ]]; then
	args+=(--update-check-interval-seconds "$SAND_ORBITD_UPDATE_CHECK_INTERVAL_SECONDS")
fi

args+=(orbitd)

exec /usr/local/bin/box-bounded-log --run "$LOG_PATH" -- \
	env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
	/usr/local/libexec/sand/sand-daemon-supervisor "${args[@]}"
