#!/usr/bin/env bash
# =============================================================================
# start-exec-daemon — 一次启动，不负责重启（学习摘录，专有代码）
#
# 由 supervise-exec-daemon 反复调用。这里丢掉 gateway / inference / egress
# token，把 OOM 分数降到 -1000，然后在 /workspace 执行
# exec-daemon serve：业务端口 1337，PTY WebSocket 1338。
# 进程退出即回到监督脚本的退避循环。
# =============================================================================
set -euo pipefail
unset SAND_GATEWAY_TOKEN SAND_INFERENCE_RENEWAL_CREDENTIAL SAND_EGRESS_TUNNEL_BEARER
export CURSOR_AGENT_SOCKET=/tmp/sand-identity.sock
{ echo -1000 > /proc/$$/oom_score_adj || sudo -n sh -c "echo -1000 > /proc/$$/oom_score_adj"; } >/dev/null 2>&1 || true
cd /workspace && /exec-daemon/exec-daemon serve --port 1337 --pty-websocket-port 1338 --auth-token local --rg-path /exec-daemon/rg --pty-auth-token local-pty --computer-use-enabled --computer-use-lazy-init --computer-use-api-width 1280 --computer-use-api-height 800 --mcp-meta-tool-enabled --origin-cli-enabled --orbitd-proxy-socket /run/orbitd-proxy/rpc.sock "$@"
